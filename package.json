{
  "name": "framesflow-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Framesflow Studio by Alitheris: a free AI video studio your chat can operate. Pro timeline, MCP connector, HTML animations, cut-outs, YouTube sourcing, exact 16:9 / 9:16 export.",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node scripts/start.mjs",
    "build": "vite build web",
    "web": "vite web",
    "mcp": "node mcp/stdio.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node --test tests/core.test.mjs tests/render.test.mjs",
    "prepublishOnly": "npm run build:cloud && vite build web && node --test tests/core.test.mjs",
    "skill": "node bin/framesflow.mjs skill",
    "build:skill": "node scripts/build-skill.mjs",
    "build:cloud": "node scripts/export-tools.mjs && node scripts/build-skill.mjs",
    "docs": "node scripts/build-docs.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "4.3.2",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@napi-rs/canvas": "1.1.0",
    "@supabase/supabase-js": "^2.119.0",
    "express": "5.3.0",
    "mp4-muxer": "^5.2.2",
    "puppeteer-core": "25.16.0",
    "ws": "8.22.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "4.7.0",
    "lucide-react": "0.468.0",
    "marked": "^15.0.12",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "vite": "6.4.1"
  },
  "homepage": "https://framesflow.online",
  "author": "Alitheris",
  "keywords": [
    "video",
    "video-editor",
    "mcp",
    "ai",
    "claude",
    "youtube",
    "faceless",
    "animation",
    "ffmpeg",
    "framesflow"
  ],
  "bin": {
    "framesflow": "bin/framesflow.mjs",
    "framesflow-studio": "bin/framesflow.mjs"
  },
  "files": [
    "bin",
    "server",
    "shared",
    "mcp",
    "scripts",
    "skills",
    "web/dist",
    "README.md",
    "Start-Framesflow.bat"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
